<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.go.meti.drone.relatedpartiesnotice.reservenotification.repository.mapper.ReserveNotificationMapper">
  <resultMap id="ReserveNotificationMap" type="jp.go.meti.drone.relatedpartiesnotice.reservenotification.repository.entity.ReserveNotificationEntity">
    <id column="airwayReserve_id" jdbcType="VARCHAR" property="airwayReserveId" />
    <result column="request_id" jdbcType="VARCHAR" property="requestId" />
    <result column="related_category" jdbcType="CHAR" property="relatedCategory" />
    <result column="operator_id" jdbcType="VARCHAR" property="operatorId" />
    <result column="operator_name" jdbcType="VARCHAR" property="operatorName" />
    <result column="notification_email" jdbcType="CHAR" property="notificationEmail" />
    <result column="notification_phone" jdbcType="VARCHAR" property="notificationPhone" />
    <result column="notification_remark" jdbcType="VARCHAR" property="notificationRemark" />
    <result column="creation_id" jdbcType="INTEGER" property="creationId" />
    <result column="creation_datetime" jdbcType="TIMESTAMP" property="creationDatetime" />
    <result column="update_id" jdbcType="INTEGER" property="updateId" />
    <result column="update_datetime" jdbcType="TIMESTAMP" property="updateDatetime" />
  </resultMap>
     <!-- 航路予約関係者テーブルから予約IDで関連パーティを検索 -->
    <select id="findReserveNotificationByIds" resultMap="ReserveNotificationMap">
        SELECT * 
        FROM airway_reserve_related
        WHERE airway_reserve_id = #{airwayReserveId}
        OR request_id = #{airwayReserveId}
    </select>
</mapper>