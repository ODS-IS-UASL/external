<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
  <context id="PostgresTables" targetRuntime="MyBatis3">
    <plugin type="org.mybatis.generator.plugins.RowBoundsPlugin" />
    <plugin type="org.mybatis.generator.plugins.VirtualPrimaryKeyPlugin" />
    <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin" />
    <plugin type="org.mybatis.generator.plugins.SerializablePlugin" />
    <plugin type="jp.go.meti.drone.tools.mbg.plugins.ForUpdatePlugin" />
    <plugin type="jp.go.meti.drone.tools.mbg.plugins.LimitPlugin" />
    <plugin type="com.softwareloop.mybatis.generator.plugins.LombokPlugin">
        <!-- enable annotations -->
        <property name="builder" value="true"/>
        <property name="allArgsConstructor" value="true"/>
        <!-- disable annotations -->
        <property name="noArgsConstructor" value="false"/>
    </plugin>

		<jdbcConnection
			driverClass="org.postgresql.Driver"
			connectionURL="jdbc:postgresql://localhost:5432/external_integration"
			userId="postgres"
			password="postgres" />

		<!-- 日付型のフィールドをJavaのDatetimeAPIとして生成する設定 -->
		<javaTypeResolver>
			<property name="useJSR310Types" value="true" />
		</javaTypeResolver>

		<!-- SELECT 結果等を格納するドメインモデルを生成する設定 -->
		<javaModelGenerator
			targetPackage="jp.go.meti.drone.swim.repository.entity"
			targetProject="src/main/java">
			<property name="enableSubPackages" value="true" />
			<property name="trimStrings" value="true" />
		</javaModelGenerator>
		
		<!-- SQL 設定が記述された XML を生成する設定 -->
		<sqlMapGenerator
			targetPackage="jp.go.meti.drone.swim.repository.mapper"
			targetProject="src/main/resources">
			<property name="enableSubPackages" value="true" />
		</sqlMapGenerator>
		
		<!-- リポジトリインタフェースを生成する設定 -->
		<javaClientGenerator type="XMLMAPPER"
			targetPackage="jp.go.meti.drone.swim.repository.mapper"
			targetProject="src/main/java">
			<property name="enableSubPackages" value="true" />
		</javaClientGenerator>

    
		<!-- コードを生成するテーブルを指定 -->
    	<table tableName="swim_max_fall_range"
			domainObjectName="SwimMaxFallRangeEntity"
			mapperName="SwimMaxFallRangeRepository" modelType="flat">
			<property name="ignoreQualifiersAtRuntime" value="true" />
			<property name="useActualColumnNames" value="false" />
		</table>
		
    	<table tableName="swim_feedback"
			domainObjectName="SwimFeedbackEntity"
			mapperName="SwimFeedbackRepository" modelType="flat">
			<property name="ignoreQualifiersAtRuntime" value="true" />
			<property name="useActualColumnNames" value="false" />
		</table>
		
    	<table tableName="swim_max_fall_range_history"
			domainObjectName="SwimMaxFallRangeHistoryEntity"
			mapperName="SwimMaxFallRangeHistoryRepository" modelType="flat">
			<property name="ignoreQualifiersAtRuntime" value="true" />
			<property name="useActualColumnNames" value="false" />
		</table>
    

  </context>
  
</generatorConfiguration>
